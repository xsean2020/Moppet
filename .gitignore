# SwiftPM build products (never commit — tens of GB of intermediates)
.build/
.swiftpm/
Package.resolved.lock

# Xcode / macOS noise
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
.DS_Store

# Local data that must never be tracked
*.p12
*.mobileprovision

# Local tool output (Qoder repowiki / IDE caches) — never published
.qoder/

# .app bundle output (scripts/make-app.sh)
dist/

# Local agent workspace data (memory, not source)
.workbuddy-ai/

# Generated by scripts/make-app.sh from assets/Moppet.iconset
assets/Moppet.icns
